# Server
PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080

# Production image tag (used by docker-compose.prod.yml)
IMAGE_TAG=latest

# Database (Postgres)
# Local dev:  postgres://authuser:authpassword@localhost:5432/authdb?sslmode=disable
# Production (docker-compose.prod.yml overrides this with the internal hostname automatically)
DB_DSN=postgres://authuser:authpassword@localhost:5432/authdb?sslmode=disable

# Postgres credentials — used by docker-compose.prod.yml to create the DB container
POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpassword   # use a strong password in production
POSTGRES_DB=authdb

# Redis
# Production (docker-compose.prod.yml overrides this with the internal hostname automatically)
REDIS_URL=redis://localhost:6379/0

# RSA key pair (generated by: make generate-certs)
RSA_PRIVATE_KEY_PATH=certs/private.pem
RSA_PUBLIC_KEY_PATH=certs/public.pem

# Session
# Must be a random 32+ byte secret in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=EpQ6pGzCF3vkXCfP5F12HY8qqr/p7ovk9k1DBk6wqdk=

# Redis encryption key
# Used to encrypt sensitive values in Redis (e.g. OAuth2 client secret flash).
# Must be exactly 64 lowercase hex characters (32 bytes) in production.
# Generate one with: openssl rand -hex 32
# In development, an insecure fallback key is used automatically.
REDIS_ENCRYPTION_KEY=e426b5dea0c75ad0eeaeb19b53f9fc52d9b2bc639567293a55c5e4945518834f

# SMTP (email)
# Local dev uses Mailpit: make mailpit-up  →  http://localhost:8025
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_INSECURE_SKIP_VERIFY=true
#
# Resend (production):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USERNAME=resend
#   SMTP_PASSWORD=<your-api-key>  SMTP_FROM=you@yourdomain.com
#
# TLS is selected automatically:
#   port 465            → implicit SSL/TLS (SMTPS)
#   port 587 or other  → STARTTLS (mandatory)
#   SMTP_INSECURE_SKIP_VERIFY=true → no TLS (local dev only)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=test
SMTP_PASSWORD=test
SMTP_FROM=noreply@auth.anekdote.in
SMTP_INSECURE_SKIP_VERIFY=false

# Cloudflare Tunnel (used by docker-compose.prod.yml)
# Create a tunnel in the Cloudflare dashboard, point it to http://app:8080, copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Audit log
# Number of days to retain admin audit log entries. Default: 90.
AUDIT_RETENTION_DAYS=90
