# Server
PORT=8080
APP_ENV=development          # development | production
APP_URL=http://localhost:8080

# Database (Postgres)
# Local:      postgres://authuser:authpassword@localhost:5432/authdb?sslmode=disable
# Supabase:   postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/ssl/certs/supabase-ca.crt
DB_DSN=postgres://authuser:authpassword@localhost:5432/authdb?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# RSA key pair (generated by: make generate-certs)
RSA_PRIVATE_KEY_PATH=certs/private.pem
RSA_PUBLIC_KEY_PATH=certs/public.pem

# Session
# Must be a random 32+ byte secret in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=super-secret-session-key-change-in-prod

# SMTP (email)
# Local dev uses Mailpit: make mailpit-up  →  http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=test
SMTP_PASSWORD=test
SMTP_FROM=noreply@anekdoteauth.local
SMTP_INSECURE_SKIP_VERIFY=false   # set to true for local Mailpit

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Admin panel
# Comma-separated list of email addresses that can access /admin/*.
# These users must also have a valid account; admin status is checked live on every request.
# Example: ADMIN_EMAILS=alice@example.com,bob@example.com
ADMIN_EMAILS=
