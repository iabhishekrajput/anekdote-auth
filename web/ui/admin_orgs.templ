package ui

import (
	"github.com/iabhishekrajput/anekdote-auth/internal/models"
	"github.com/iabhishekrajput/anekdote-auth/internal/store/postgres"
)

templ AdminOrgList(csrfToken string, orgs []postgres.AdminOrgItem, total int, cursor, nextCursor string, errorMsg, successMsg string) {
	@AdminLayout("Orgs - Admin", "/admin/orgs", csrfToken, adminOrgListBody(orgs, total, cursor, nextCursor, errorMsg, successMsg))
}

templ adminOrgListBody(orgs []postgres.AdminOrgItem, total int, cursor, nextCursor string, errorMsg, successMsg string) {
	<div class="space-y-4">
		<div>
			<h1 class="text-xl font-semibold tracking-tight">Organizations</h1>
			<p class="text-sm text-zinc-400">{ intToStr(total) } orgs on the platform</p>
		</div>
		@AlertContainer(errorMsg, successMsg)
		<div class="rounded-lg border border-zinc-800 overflow-hidden">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-zinc-800 bg-zinc-900/60">
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Name</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Slug</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Members</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Clients</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Created</th>
						<th class="px-4 py-2.5"></th>
					</tr>
				</thead>
				<tbody>
					if len(orgs) == 0 {
						<tr>
							<td colspan="6" class="px-4 py-8 text-center text-zinc-500">No organizations yet.</td>
						</tr>
					}
					for _, o := range orgs {
						<tr class="border-b border-zinc-800/60 last:border-0 hover:bg-zinc-900/40">
							<td class="px-4 py-3 font-medium text-zinc-200">{ o.Org.DisplayName }</td>
							<td class="px-4 py-3 font-mono text-xs text-zinc-400">{ o.Org.Slug }</td>
							<td class="px-4 py-3 tabular-nums text-zinc-300">{ intToStr(o.MemberCount) }</td>
							<td class="px-4 py-3 tabular-nums text-zinc-300">{ intToStr(o.ClientCount) }</td>
							<td class="px-4 py-3 text-xs text-zinc-500">{ o.Org.CreatedAt.Format("2006-01-02") }</td>
							<td class="px-4 py-3 text-right">
								<a href={ templ.SafeURL("/admin/orgs/" + o.Org.Slug) } class="text-xs text-brand hover:underline">Manage</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@cursorPaginationControls("/admin/orgs", cursor, nextCursor)
	</div>
}

templ AdminOrgDetail(csrfToken string, org *models.Org, members []*models.OrgMembership, errorMsg, successMsg string) {
	@AdminLayout("Org Detail - Admin", "/admin/orgs", csrfToken, adminOrgDetailBody(csrfToken, org, members, errorMsg, successMsg))
}

templ adminOrgDetailBody(csrfToken string, org *models.Org, members []*models.OrgMembership, errorMsg, successMsg string) {
	<div class="space-y-6 max-w-2xl">
		<div class="flex items-center gap-3">
			<a href="/admin/orgs" class="text-sm text-zinc-400 hover:text-zinc-200">← Organizations</a>
		</div>
		<div>
			<h1 class="text-xl font-semibold tracking-tight">{ org.DisplayName }</h1>
			<p class="text-sm text-zinc-400 font-mono">{ org.Slug }</p>
		</div>
		@AlertContainer(errorMsg, successMsg)
		<div class="rounded-lg border border-zinc-800 overflow-hidden">
			<div class="px-4 py-3 border-b border-zinc-800">
				<p class="text-xs text-zinc-500 uppercase tracking-wide">Members</p>
			</div>
			if len(members) == 0 {
				<p class="px-4 py-4 text-sm text-zinc-500">No members.</p>
			} else {
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-zinc-800 bg-zinc-900/60">
							<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Email</th>
							<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Role</th>
							<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Joined</th>
							<th class="px-4 py-2.5"></th>
						</tr>
					</thead>
					<tbody>
						for _, m := range members {
							<tr class="border-b border-zinc-800/60 last:border-0 hover:bg-zinc-900/40">
								<td class="px-4 py-3 font-mono text-xs text-zinc-200">{ m.UserEmail }</td>
								<td class="px-4 py-3">
									<span class={ adminOrgRoleBadgeClass(m.Role) }>{ m.Role }</span>
								</td>
								<td class="px-4 py-3 text-xs text-zinc-500">{ m.JoinedAt.Format("2006-01-02") }</td>
								<td class="px-4 py-3 text-right">
									if m.Role != "owner" {
										<form
											method="POST"
											action={ templ.SafeURL("/admin/orgs/" + org.Slug + "/members/" + m.UserID.String() + "/remove") }
											data-confirm="Remove this member from the org?"
										>
											<input type="hidden" name="csrf_token" value={ csrfToken }/>
											<button type="submit" class="text-xs text-red-400 hover:underline">Remove</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
		<div class="rounded-lg border border-red-900/40 p-4 space-y-2">
			<p class="text-sm font-medium text-red-400">Danger zone</p>
			<form
				method="POST"
				action={ templ.SafeURL("/admin/orgs/" + org.Slug + "/delete") }
				data-confirm={ "Permanently delete org '" + org.Slug + "'? All clients and members will be removed." }
			>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<button
					type="submit"
					class="inline-flex h-8 items-center gap-1.5 rounded-md border border-red-800 px-3 text-sm text-red-400 hover:bg-red-500/10 transition-colors"
				>Delete org</button>
			</form>
		</div>
	</div>
}
