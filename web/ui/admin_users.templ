package ui

import (
	"github.com/iabhishekrajput/anekdote-auth/internal/models"
	"github.com/iabhishekrajput/anekdote-auth/internal/store/postgres"
	"strings"
)

templ AdminUserList(csrfToken string, users []*postgres.UserListItem, total int, cursor, nextCursor string, errorMsg, successMsg string) {
	@AdminLayout("Users - Admin", "/admin/users", csrfToken, adminUserListBody(csrfToken, users, total, cursor, nextCursor, errorMsg, successMsg))
}

templ adminUserListBody(csrfToken string, users []*postgres.UserListItem, total int, cursor, nextCursor string, errorMsg, successMsg string) {
	<div class="space-y-4">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-xl font-semibold tracking-tight">Users</h1>
				<p class="text-sm text-zinc-400">{ intToStr(total) } total</p>
			</div>
		</div>
		@AlertContainer(errorMsg, successMsg)
		<div class="rounded-lg border border-zinc-800 overflow-hidden">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-zinc-800 bg-zinc-900/60">
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Email</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Name</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Verified</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Status</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Joined</th>
						<th class="px-4 py-2.5"></th>
					</tr>
				</thead>
				<tbody>
					if len(users) == 0 {
						<tr>
							<td colspan="6" class="px-4 py-8 text-center text-zinc-500">No users found.</td>
						</tr>
					}
					for _, u := range users {
						<tr class={ disabledRowClass(u.DisabledAt != nil) }>
							<td class="px-4 py-3 font-mono text-xs text-zinc-200">{ u.Email }</td>
							<td class="px-4 py-3 text-zinc-300">{ u.Name }</td>
							<td class="px-4 py-3">
								if u.IsVerified {
									<span class="text-xs text-emerald-400">Yes</span>
								} else {
									<span class="text-xs text-zinc-500">No</span>
								}
							</td>
							<td class="px-4 py-3">
								if u.DisabledAt != nil {
									<span class="rounded bg-red-500/10 px-1.5 py-0.5 text-xs text-red-400">Disabled</span>
								} else {
									<span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-xs text-emerald-400">Active</span>
								}
							</td>
							<td class="px-4 py-3 text-xs text-zinc-500">{ u.CreatedAt.Format("2006-01-02") }</td>
							<td class="px-4 py-3 text-right">
								<a href={ templ.SafeURL("/admin/users/" + u.ID) } class="text-xs text-brand hover:underline">View</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@cursorPaginationControls("/admin/users", cursor, nextCursor)
	</div>
}

templ AdminUserDetail(csrfToken string, user *models.User, orgs []postgres.OrgListItem, isLastAdmin bool, errorMsg, successMsg string) {
	@AdminLayout("User Detail - Admin", "/admin/users", csrfToken, adminUserDetailBody(csrfToken, user, orgs, isLastAdmin, errorMsg, successMsg))
}

templ adminUserDetailBody(csrfToken string, user *models.User, orgs []postgres.OrgListItem, isLastAdmin bool, errorMsg, successMsg string) {
	<div class="space-y-6 max-w-2xl">
		<div class="flex items-center gap-3">
			<a href="/admin/users" class="text-sm text-zinc-400 hover:text-zinc-200">← Users</a>
		</div>
		<div>
			<h1 class="text-xl font-semibold tracking-tight">{ user.Email }</h1>
			<p class="text-sm text-zinc-400">User ID: { user.ID }</p>
		</div>
		@AlertContainer(errorMsg, successMsg)
		<div class="rounded-lg border border-zinc-800 divide-y divide-zinc-800">
			<div class="px-4 py-3">
				<p class="text-xs text-zinc-500 uppercase tracking-wide">Profile</p>
			</div>
			<div class="px-4 py-3 flex justify-between text-sm">
				<span class="text-zinc-400">Name</span>
				<span class="text-zinc-200">{ user.Name }</span>
			</div>
			<div class="px-4 py-3 flex justify-between text-sm">
				<span class="text-zinc-400">Email verified</span>
				if user.IsVerified {
					<span class="text-emerald-400">Yes</span>
				} else {
					<span class="text-zinc-500">No</span>
				}
			</div>
			<div class="px-4 py-3 flex justify-between text-sm">
				<span class="text-zinc-400">Status</span>
				if user.DisabledAt != nil {
					<span class="text-red-400">Disabled since { user.DisabledAt.Format("2006-01-02 15:04 UTC") }</span>
				} else {
					<span class="text-emerald-400">Active</span>
				}
			</div>
			<div class="px-4 py-3 flex justify-between text-sm">
				<span class="text-zinc-400">Admin</span>
				if user.IsAdmin {
					<span class="rounded bg-violet-500/10 px-1.5 py-0.5 text-xs text-violet-400">{ adminRoleLabel(user.AdminRole) }</span>
				} else {
					<span class="text-zinc-500">No</span>
				}
			</div>
			<div class="px-4 py-3 flex justify-between text-sm">
				<span class="text-zinc-400">Joined</span>
				<span class="text-zinc-300">{ user.CreatedAt.Format("2006-01-02 15:04 UTC") }</span>
			</div>
		</div>
		<div class="rounded-lg border border-zinc-800 p-4 space-y-3">
			<p class="text-sm font-medium text-zinc-300">Account actions</p>
			if user.DisabledAt != nil {
				<form
					method="POST"
					action={ templ.SafeURL("/admin/users/" + user.ID + "/enable") }
					data-confirm="Re-enable this account? The user will regain full access."
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button
						type="submit"
						class="inline-flex h-8 items-center gap-1.5 rounded-md border border-emerald-700 px-3 text-sm text-emerald-400 hover:bg-emerald-500/10 transition-colors"
					>Re-enable account</button>
				</form>
			} else {
				<form
					method="POST"
					action={ templ.SafeURL("/admin/users/" + user.ID + "/disable") }
					data-confirm="Disable this user and revoke all their active sessions?"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button
						type="submit"
						class="inline-flex h-8 items-center gap-1.5 rounded-md border border-red-800 px-3 text-sm text-red-400 hover:bg-red-500/10 transition-colors"
					>Disable account</button>
				</form>
			}
		</div>
		<div class="rounded-lg border border-zinc-800 p-4 space-y-3">
			<p class="text-sm font-medium text-zinc-300">Admin access</p>
			if user.IsAdmin {
				<form
					method="POST"
					action={ templ.SafeURL("/admin/users/" + user.ID + "/demote") }
					data-confirm={ "Remove admin access from " + user.Email + "?" }
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					if isLastAdmin {
						<button
							type="button"
							disabled
							class="inline-flex h-8 items-center gap-1.5 rounded-md border border-zinc-700 px-3 text-sm text-zinc-500 opacity-40 cursor-not-allowed"
							title="Cannot remove the last admin"
						>Remove admin access</button>
					} else {
						<button
							type="submit"
							class="inline-flex h-8 items-center gap-1.5 rounded-md border border-amber-800 px-3 text-sm text-amber-400 hover:bg-amber-500/10 transition-colors"
						>Remove admin access</button>
					}
				</form>
				<form
					method="POST"
					action={ templ.SafeURL("/admin/users/" + user.ID + "/admin-role") }
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="flex items-center gap-2">
						<select
							name="role"
							class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-sm text-zinc-200 focus:border-brand focus:outline-none"
						>
							<option value="superadmin" selected?={ user.AdminRole == "superadmin" }>Superadmin — full access</option>
							<option value="readonly" selected?={ user.AdminRole == "readonly" }>Readonly — view only</option>
							<option value="org_admin" selected?={ user.AdminRole == "org_admin" }>Org admin — org management</option>
						</select>
						<button
							type="submit"
							class="inline-flex h-8 items-center gap-1.5 rounded-md border border-violet-800 px-3 text-sm text-violet-400 hover:bg-violet-500/10 transition-colors"
						>Set role</button>
					</div>
				</form>
			} else {
				<form
					method="POST"
					action={ templ.SafeURL("/admin/users/" + user.ID + "/promote") }
					data-confirm={ "Grant admin access to " + user.Email + "? They will have full access to this admin panel." }
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button
						type="submit"
						class="inline-flex h-8 items-center gap-1.5 rounded-md border border-violet-800 px-3 text-sm text-violet-400 hover:bg-violet-500/10 transition-colors"
					>Grant admin access</button>
				</form>
			}
		</div>
		<div class="rounded-lg border border-zinc-800 overflow-hidden">
			<div class="px-4 py-3 border-b border-zinc-800">
				<p class="text-xs text-zinc-500 uppercase tracking-wide">Organization memberships</p>
			</div>
			if len(orgs) == 0 {
				<p class="px-4 py-4 text-sm text-zinc-500">No organization memberships.</p>
			} else {
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-zinc-800 bg-zinc-900/60">
							<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Organization</th>
							<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Role</th>
							<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Members</th>
						</tr>
					</thead>
					<tbody>
						for _, o := range orgs {
							<tr class="border-b border-zinc-800/60 last:border-0">
								<td class="px-4 py-3">
									<a href={ templ.SafeURL("/admin/orgs/" + o.Org.Slug) } class="text-brand hover:underline">{ o.Org.DisplayName }</a>
									<span class="ml-1 text-xs text-zinc-500">{ o.Org.Slug }</span>
								</td>
								<td class="px-4 py-3">
									<span class={ adminOrgRoleBadgeClass(o.Role) }>{ strings.ToTitle(o.Role[:1]) + o.Role[1:] }</span>
								</td>
								<td class="px-4 py-3 text-zinc-400">{ intToStr(o.MemberCount) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
		<div class="rounded-lg border border-red-900/40 p-4 space-y-2">
			<p class="text-sm font-medium text-red-400">Danger zone</p>
			<form
				method="POST"
				action={ templ.SafeURL("/admin/users/" + user.ID + "/delete") }
				data-confirm={ "Permanently delete " + user.Email + "? This anonymizes their data and cannot be undone." }
			>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<button
					type="submit"
					class="inline-flex h-8 items-center gap-1.5 rounded-md border border-red-800 px-3 text-sm text-red-400 hover:bg-red-500/10 transition-colors"
				>Delete user</button>
			</form>
		</div>
	</div>
}

func disabledRowClass(disabled bool) string {
	base := "border-b border-zinc-800/60 last:border-0 hover:bg-zinc-900/40"
	if disabled {
		return base + " opacity-50"
	}
	return base
}

func adminOrgRoleBadgeClass(role string) string {
	switch role {
	case "owner":
		return "rounded bg-amber-500/10 px-1.5 py-0.5 text-xs text-amber-400"
	case "admin":
		return "rounded bg-blue-500/10 px-1.5 py-0.5 text-xs text-blue-400"
	default:
		return "rounded bg-zinc-700/50 px-1.5 py-0.5 text-xs text-zinc-400"
	}
}

func adminRoleLabel(role string) string {
	switch role {
	case "readonly":
		return "Admin (readonly)"
	case "org_admin":
		return "Admin (org)"
	default:
		return "Admin"
	}
}
