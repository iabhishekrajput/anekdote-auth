package ui

import "github.com/iabhishekrajput/anekdote-auth/internal/models"

templ AccountPage(csrfToken string, user *models.User, errorMsg string, successMsg string) {
	@AccountLayout("Account Settings - anekdote", "/account", AccountPageBody(csrfToken, user, errorMsg, successMsg))
}

templ AccountPageBody(csrfToken string, user *models.User, errorMsg string, successMsg string) {
	<div class="w-full max-w-2xl mx-auto space-y-0">
		<div class="mb-8">
			<h1 class="text-xl font-semibold tracking-tight">Account settings</h1>
			<p class="mt-0.5 text-sm text-zinc-400">Manage your profile and security</p>
		</div>

		@AlertContainer(errorMsg, successMsg)

		<section>
			<h3 class="text-base font-semibold">Profile</h3>
			<p class="mt-0.5 text-sm text-zinc-400">Update your display name</p>
			<div class="mt-4 pb-8 border-b border-zinc-800/60">
				<form method="POST" action="/account/profile" class="flex flex-col gap-4 max-w-sm">
					<input type="hidden" name="csrf_token" value={ csrfToken } />
					@FormField("Full name", "name", "", TextInput("name", "name", "text", "Jane Doe", user.Name, false))
					<div>
						@OutlineButton("Save changes")
					</div>
				</form>
			</div>
		</section>

		<section class="mt-8">
			<h3 class="text-base font-semibold">Change password</h3>
			<p class="mt-0.5 text-sm text-zinc-400">Update your security credentials</p>
			<div class="mt-4 pb-8 border-b border-zinc-800/60">
				<form method="POST" action="/account/password" class="flex flex-col gap-4 max-w-sm" data-confirm-form>
					<input type="hidden" name="csrf_token" value={ csrfToken } />
					@FormField("Current password", "old_password", "", PasswordInput("old_password", "old_password", false))
					@FormField("New password", "new_password", "", PasswordInput("new_password", "new_password", false))
					<div>
						@OutlineButton("Update password")
					</div>
				</form>
			</div>
		</section>

		<section class="mt-8 pt-0">
			<div class="mt-2 border-t border-red-900/30 pt-6">
				<h3 class="text-base font-semibold text-zinc-50">Sign out</h3>
				<p class="mt-0.5 text-sm text-zinc-400">End your current session on this device</p>
				<div class="mt-4 max-w-sm">
					<form method="POST" action="/logout">
						<input type="hidden" name="csrf_token" value={ csrfToken } />
						@DestructiveButton("Sign out")
					</form>
				</div>
			</div>
		</section>
	</div>
}
