package ui

templ ResetPasswordPage(csrfToken string, token string, errorMsg string, successMsg string) {
	@BaseLayout("Reset Password - anekdote", ResetPasswordPageBody(csrfToken, token, errorMsg, successMsg))
}

templ ResetPasswordPageBody(csrfToken string, token string, errorMsg string, successMsg string) {
	<div class="w-full space-y-6 rounded-lg border border-zinc-800 bg-zinc-900 p-6 shadow">
		<div class="flex flex-col items-center gap-1.5 text-center">
			<h2 class="text-xl font-semibold tracking-tight">Set a new password</h2>
			<p class="text-sm text-zinc-400">Choose something you haven't used before.</p>
		</div>

		@AlertContainer(errorMsg, successMsg)

		<form method="POST" action="/reset-password" class="flex flex-col gap-5" data-confirm-form>
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			<input type="hidden" name="token" value={ token } />

			<div class="flex flex-col gap-4">
				@FormField("New password", "password", "", PasswordInput("password", "password", false))

				<div class="flex flex-col gap-1.5">
					<label for="confirm_password" class="text-sm font-medium text-zinc-50">Confirm password</label>
					@PasswordInput("confirm_password", "confirm_password", false)
					<p id="confirm_password-error" class="hidden text-xs text-red-400 mt-0.5"></p>
				</div>
			</div>

			@PrimaryButton("Update password")
		</form>
	</div>
}
