package email

templ SecretRotatedEmail(clientName, orgName string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Secret rotated for { clientName } - anekdote</title>
			<style>
				body {
					font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
					background-color: #09090b;
					color: #fafafa;
					margin: 0;
					padding: 0;
					line-height: 1.6;
					-webkit-font-smoothing: antialiased;
				}
				.container { max-width: 600px; margin: 40px auto; padding: 20px; }
				.card {
					background-color: #09090b;
					border: 1px solid #27272a;
					border-radius: 8px;
					padding: 32px;
					text-align: center;
					box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
				}
				.header { margin-bottom: 24px; }
				.header h2 { margin: 0; color: #fafafa; font-size: 24px; font-weight: 600; letter-spacing: -0.025em; }
				.badge {
					display: inline-block;
					background-color: #1e3a5f;
					color: #93c5fd;
					font-size: 12px;
					font-weight: 600;
					padding: 4px 12px;
					border-radius: 9999px;
					margin-bottom: 16px;
				}
				.content { font-size: 16px; color: #a1a1aa; margin-bottom: 24px; }
				.note {
					font-size: 13px;
					color: #71717a;
					background-color: #18181b;
					border: 1px solid #27272a;
					border-radius: 6px;
					padding: 12px 16px;
					margin-bottom: 24px;
					text-align: left;
				}
				.footer {
					font-size: 12px;
					color: #a1a1aa;
					margin-top: 32px;
					border-top: 1px solid #27272a;
					padding-top: 24px;
				}
			</style>
		</head>
		<body>
			<div class="container">
				<div class="card">
					<div class="header">
						<div class="badge">Secret rotated</div>
						<h2>Client secret rotated for { clientName }</h2>
					</div>
					<div class="content">
						<p>The client secret for <strong>{ clientName }</strong> owned by <strong>{ orgName }</strong> was just rotated. The previous secret is now invalid.</p>
					</div>
					<div class="note">
						<strong>Action required:</strong> Update your application configuration with the new client secret shown in your dashboard.
					</div>
					<div class="footer">
						<p>If you did not perform this action, please contact support immediately.</p>
						<p>&copy; 2026 anekdote. All rights reserved.</p>
					</div>
				</div>
			</div>
		</body>
	</html>
}
