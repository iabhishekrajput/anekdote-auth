package email

templ GrantRevokedEmail(clientName, orgName string, adminRevoke bool, reason string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Access to { clientName } removed - anekdote</title>
			<style>
				body {
					font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
					background-color: #09090b;
					color: #fafafa;
					margin: 0;
					padding: 0;
					line-height: 1.6;
					-webkit-font-smoothing: antialiased;
				}
				.container { max-width: 600px; margin: 40px auto; padding: 20px; }
				.card {
					background-color: #09090b;
					border: 1px solid #27272a;
					border-radius: 8px;
					padding: 32px;
					text-align: center;
					box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
				}
				.header { margin-bottom: 24px; }
				.header h2 { margin: 0; color: #fafafa; font-size: 24px; font-weight: 600; letter-spacing: -0.025em; }
				.badge {
					display: inline-block;
					background-color: #431407;
					color: #fdba74;
					font-size: 12px;
					font-weight: 600;
					padding: 4px 12px;
					border-radius: 9999px;
					margin-bottom: 16px;
				}
				.content { font-size: 16px; color: #a1a1aa; margin-bottom: 24px; }
				.reason-box {
					font-size: 14px;
					color: #a1a1aa;
					background-color: #18181b;
					border: 1px solid #27272a;
					border-radius: 6px;
					padding: 12px 16px;
					margin-bottom: 24px;
					text-align: left;
				}
				.footer {
					font-size: 12px;
					color: #a1a1aa;
					margin-top: 32px;
					border-top: 1px solid #27272a;
					padding-top: 24px;
				}
			</style>
		</head>
		<body>
			<div class="container">
				<div class="card">
					<div class="header">
						<div class="badge">Access removed</div>
						<h2>{ orgName }'s access to { clientName } removed</h2>
					</div>
					<div class="content">
						if adminRevoke {
							<p>A platform administrator has removed <strong>{ orgName }</strong>'s access to <strong>{ clientName }</strong>. Any existing tokens will be invalidated.</p>
						} else {
							<p><strong>{ orgName }</strong> removed its access to <strong>{ clientName }</strong>. Any existing tokens have been invalidated.</p>
						}
					</div>
					if reason != "" {
						<div class="reason-box">
							<strong>Reason:</strong> { reason }
						</div>
					}
					<div class="footer">
						<p>&copy; 2026 anekdote. All rights reserved.</p>
					</div>
				</div>
			</div>
		</body>
	</html>
}
