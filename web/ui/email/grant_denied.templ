package email

templ GrantDeniedEmail(clientName, requesterOrgName string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Access request for { clientName } denied - anekdote</title>
			<style>
				body {
					font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
					background-color: #09090b;
					color: #fafafa;
					margin: 0;
					padding: 0;
					line-height: 1.6;
					-webkit-font-smoothing: antialiased;
				}
				.container { max-width: 600px; margin: 40px auto; padding: 20px; }
				.card {
					background-color: #09090b;
					border: 1px solid #27272a;
					border-radius: 8px;
					padding: 32px;
					text-align: center;
					box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
				}
				.header { margin-bottom: 24px; }
				.header h2 { margin: 0; color: #fafafa; font-size: 24px; font-weight: 600; letter-spacing: -0.025em; }
				.badge {
					display: inline-block;
					background-color: #450a0a;
					color: #fca5a5;
					font-size: 12px;
					font-weight: 600;
					padding: 4px 12px;
					border-radius: 9999px;
					margin-bottom: 16px;
				}
				.content { font-size: 16px; color: #a1a1aa; margin-bottom: 32px; }
				.footer {
					font-size: 12px;
					color: #a1a1aa;
					margin-top: 32px;
					border-top: 1px solid #27272a;
					padding-top: 24px;
				}
			</style>
		</head>
		<body>
			<div class="container">
				<div class="card">
					<div class="header">
						<div class="badge">Denied</div>
						<h2>Access request denied</h2>
					</div>
					<div class="content">
						<p><strong>{ requesterOrgName }</strong>'s access request to <strong>{ clientName }</strong> was denied by the client owner.</p>
						<p>If you believe this is an error, contact the client owner directly.</p>
					</div>
					<div class="footer">
						<p>&copy; 2026 anekdote. All rights reserved.</p>
					</div>
				</div>
			</div>
		</body>
	</html>
}
