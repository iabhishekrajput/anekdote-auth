package ui

import (
	"fmt"
	"strconv"
	"time"

	"github.com/iabhishekrajput/anekdote-auth/internal/store/postgres"
)

templ AdminLayout(title string, currentPath string, csrfToken string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="min-h-screen bg-zinc-950 text-zinc-50">
			<header class="border-b border-zinc-800 px-6 py-3">
				<div class="mx-auto flex max-w-5xl items-center justify-between">
					<div class="flex items-center gap-3">
						@Logo("sm")
						<span class="rounded bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-400 uppercase tracking-wide">Admin</span>
					</div>
					<div class="flex items-center gap-2">
						<nav class="flex items-center gap-1">
							<a href="/admin" class={ adminNavClass(currentPath, "/admin") }>Dashboard</a>
							<a href="/admin/users" class={ adminNavClass(currentPath, "/admin/users") }>Users</a>
							<a href="/admin/clients" class={ adminNavClass(currentPath, "/admin/clients") }>Clients</a>
							<a href="/admin/orgs" class={ adminNavClass(currentPath, "/admin/orgs") }>Orgs</a>
							<a href="/admin/audit" class={ adminNavClass(currentPath, "/admin/audit") }>Audit</a>
						</nav>
						<span class="h-4 w-px bg-zinc-800 mx-1"></span>
						<a
							href="/account"
							title="My account"
							aria-label="My account"
							class="flex h-8 w-8 items-center justify-center rounded-md text-zinc-400 hover:text-zinc-50 hover:bg-zinc-900 transition-colors duration-150"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
								<circle cx="12" cy="7" r="4"></circle>
							</svg>
						</a>
						<form method="POST" action="/logout">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button
								type="submit"
								title="Sign out"
								aria-label="Sign out"
								class="flex h-8 w-8 items-center justify-center rounded-md text-zinc-400 hover:text-zinc-50 hover:bg-zinc-900 transition-colors duration-150"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
									<polyline points="16 17 21 12 16 7"></polyline>
									<line x1="21" y1="12" x2="9" y2="12"></line>
								</svg>
							</button>
						</form>
					</div>
				</div>
			</header>
			<main class="mx-auto max-w-5xl px-6 py-8">
				@body
			</main>
			<script src="/static/app.js"></script>
		</body>
	</html>
}

func adminNavClass(currentPath, target string) string {
	base := "px-3 py-1.5 rounded-md text-sm transition-colors duration-150 "
	if currentPath == target || (len(currentPath) > len(target) && currentPath[:len(target)] == target && target != "/admin") {
		return base + "bg-zinc-800 text-brand font-medium"
	}
	return base + "text-zinc-400 hover:text-zinc-50 hover:bg-zinc-900"
}

templ AdminDashboard(csrfToken string, userCount, orgCount, clientCount int, dbErr bool) {
	@AdminLayout("Admin Dashboard - anekdote", "/admin", csrfToken, adminDashboardBody(userCount, orgCount, clientCount, dbErr))
}

templ adminDashboardBody(userCount, orgCount, clientCount int, dbErr bool) {
	<div class="space-y-6">
		<div>
			<h1 class="text-xl font-semibold tracking-tight">Platform Overview</h1>
			<p class="text-sm text-zinc-400">Live stats across all tenants.</p>
		</div>
		if dbErr {
			<div class="rounded-lg border border-amber-800 bg-amber-500/10 px-4 py-3 text-sm text-amber-400">
				One or more database queries failed — counts below may be inaccurate.
			</div>
		}
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
			<a href="/admin/users" class="rounded-lg border border-zinc-800 bg-zinc-900/40 p-5 hover:border-zinc-700 transition-colors">
				<p class="text-sm text-zinc-400">Total users</p>
				<p class="mt-1 text-3xl font-semibold tabular-nums">{ intToStr(userCount) }</p>
			</a>
			<a href="/admin/orgs" class="rounded-lg border border-zinc-800 bg-zinc-900/40 p-5 hover:border-zinc-700 transition-colors">
				<p class="text-sm text-zinc-400">Organizations</p>
				<p class="mt-1 text-3xl font-semibold tabular-nums">{ intToStr(orgCount) }</p>
			</a>
			<a href="/admin/clients" class="rounded-lg border border-zinc-800 bg-zinc-900/40 p-5 hover:border-zinc-700 transition-colors">
				<p class="text-sm text-zinc-400">OAuth2 clients</p>
				<p class="mt-1 text-3xl font-semibold tabular-nums">{ intToStr(clientCount) }</p>
			</a>
		</div>
		<div class="rounded-lg border border-zinc-800 p-5 text-sm text-zinc-400 space-y-1">
			<p class="font-medium text-zinc-300">Quick links</p>
			<ul class="list-disc list-inside space-y-1 mt-2">
				<li><a href="/admin/users" class="text-brand hover:underline">View all users →</a></li>
				<li><a href="/admin/clients" class="text-brand hover:underline">View all OAuth clients →</a></li>
				<li><a href="/admin/orgs" class="text-brand hover:underline">View all organizations →</a></li>
			</ul>
		</div>
	</div>
}

templ AdminAuditLog(csrfToken string, entries []*postgres.AuditLogEntry, total int, cursor, nextCursor string, filter postgres.AuditFilter, errorMsg, successMsg string) {
	@AdminLayout("Audit Log - Admin", "/admin/audit", csrfToken, adminAuditLogBody(entries, total, cursor, nextCursor, filter, errorMsg, successMsg))
}

templ adminAuditLogBody(entries []*postgres.AuditLogEntry, total int, cursor, nextCursor string, filter postgres.AuditFilter, errorMsg, successMsg string) {
	<div class="space-y-4">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-xl font-semibold tracking-tight">Audit Log</h1>
				<p class="text-sm text-zinc-400">{ intToStr(total) } matching entries</p>
			</div>
			<a
				href={ templ.SafeURL(auditExportURL(filter)) }
				class="rounded-md border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 hover:bg-zinc-800 transition-colors"
			>Export CSV</a>
		</div>
		<form method="GET" action="/admin/audit" class="flex flex-wrap gap-2 items-end">
			<div class="flex flex-col gap-1">
				<label class="text-xs text-zinc-500">Action</label>
				<select name="action" class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-sm text-zinc-200 focus:border-brand focus:outline-none">
					<option value="">All actions</option>
					<option value="disable_user" selected?={ filter.Action == "disable_user" }>disable_user</option>
					<option value="enable_user" selected?={ filter.Action == "enable_user" }>enable_user</option>
					<option value="promote_admin" selected?={ filter.Action == "promote_admin" }>promote_admin</option>
					<option value="demote_admin" selected?={ filter.Action == "demote_admin" }>demote_admin</option>
					<option value="change_admin_role" selected?={ filter.Action == "change_admin_role" }>change_admin_role</option>
					<option value="delete_client" selected?={ filter.Action == "delete_client" }>delete_client</option>
					<option value="remove_org_member" selected?={ filter.Action == "remove_org_member" }>remove_org_member</option>
				</select>
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-xs text-zinc-500">From (YYYY-MM-DD)</label>
				<input
					type="date"
					name="from"
					value={ auditFilterDate(filter.From) }
					class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-sm text-zinc-200 focus:border-brand focus:outline-none"
				/>
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-xs text-zinc-500">To (YYYY-MM-DD)</label>
				<input
					type="date"
					name="to"
					value={ auditFilterDate(filter.To) }
					class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-sm text-zinc-200 focus:border-brand focus:outline-none"
				/>
			</div>
			<button type="submit" class="rounded-md border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 hover:bg-zinc-800">Filter</button>
			if auditFilterActive(filter) {
				<a href="/admin/audit" class="rounded-md border border-zinc-700 px-3 py-1.5 text-sm text-zinc-500 hover:bg-zinc-800">Clear</a>
			}
		</form>
		@AlertContainer(errorMsg, successMsg)
		<div class="rounded-lg border border-zinc-800 overflow-hidden">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-zinc-800 bg-zinc-900/60">
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Timestamp</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Admin</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Action</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Target</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">IP</th>
					</tr>
				</thead>
				<tbody>
					if len(entries) == 0 {
						<tr>
							<td colspan="5" class="px-4 py-8 text-center text-zinc-500">No audit entries match your filter.</td>
						</tr>
					}
					for _, e := range entries {
						<tr class="border-b border-zinc-800/60 last:border-0 hover:bg-zinc-900/40">
							<td class="px-4 py-3 font-mono text-xs text-zinc-500">{ e.CreatedAt.Format("2006-01-02 15:04 UTC") }</td>
							<td class="px-4 py-3 text-xs text-zinc-300">
								if e.AdminID != nil {
									<a href={ templ.SafeURL("/admin/users/" + e.AdminID.String()) } class="text-brand hover:underline font-mono">{ e.AdminID.String()[:8] }…</a>
								} else {
									<span class="text-zinc-600">—</span>
								}
							</td>
							<td class="px-4 py-3">
								<span class={ auditActionBadgeClass(string(e.Action)) }>{ string(e.Action) }</span>
							</td>
							<td class="px-4 py-3 font-mono text-xs text-zinc-400">
								{ auditTargetLink(e.TargetType, e.TargetID) }
							</td>
							<td class="px-4 py-3 font-mono text-xs text-zinc-500">{ e.IPAddress }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@cursorPaginationControls("/admin/audit", cursor, nextCursor)
	</div>
}

// cursorPaginationControls renders the shared cursor-based "First page / Next" controls.
templ cursorPaginationControls(basePath, cursor, nextCursor string) {
	if cursor != "" || nextCursor != "" {
		<div class="flex items-center justify-between text-sm text-zinc-400">
			<div>
				if cursor != "" {
					<a href={ templ.SafeURL(basePath) } class="rounded border border-zinc-700 px-3 py-1 hover:bg-zinc-800">← First page</a>
				}
			</div>
			<div>
				if nextCursor != "" {
					<a href={ templ.SafeURL(fmt.Sprintf("%s?cursor=%s", basePath, nextCursor)) } class="rounded border border-zinc-700 px-3 py-1 hover:bg-zinc-800">Next →</a>
				}
			</div>
		</div>
	}
}

func auditActionBadgeClass(action string) string {
	switch action {
	case "disable_user", "delete_client":
		return "rounded bg-red-500/10 px-1.5 py-0.5 text-xs text-red-400"
	case "enable_user":
		return "rounded bg-emerald-500/10 px-1.5 py-0.5 text-xs text-emerald-400"
	case "remove_org_member", "demote_admin":
		return "rounded bg-amber-500/10 px-1.5 py-0.5 text-xs text-amber-400"
	case "promote_admin", "change_admin_role":
		return "rounded bg-violet-500/10 px-1.5 py-0.5 text-xs text-violet-400"
	default:
		return "rounded bg-zinc-700/50 px-1.5 py-0.5 text-xs text-zinc-400"
	}
}

func auditTargetLink(targetType, targetID string) string {
	switch targetType {
	case "user":
		return "/admin/users/" + targetID
	case "client":
		return "/admin/clients/" + targetID
	}
	return targetID
}

func intToStr(n int) string {
	return strconv.Itoa(n)
}

func auditFilterDate(t *time.Time) string {
	if t == nil {
		return ""
	}
	return t.Format("2006-01-02")
}

func auditFilterActive(f postgres.AuditFilter) bool {
	return f.AdminID != nil || f.Action != "" || f.From != nil || f.To != nil
}

func auditExportURL(f postgres.AuditFilter) string {
	u := "/admin/audit/export.csv"
	params := ""
	if f.Action != "" {
		params += "&action=" + f.Action
	}
	if f.AdminID != nil {
		params += "&admin_id=" + f.AdminID.String()
	}
	if f.From != nil {
		params += "&from=" + f.From.Format("2006-01-02")
	}
	if f.To != nil {
		params += "&to=" + f.To.Format("2006-01-02")
	}
	if params != "" {
		u += "?" + params[1:]
	}
	return u
}
