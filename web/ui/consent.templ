package ui

// OrgOption is a selectable organization in the multi-org consent picker.
type OrgOption struct {
	ID   string
	Name string
	Slug string
}

templ ConsentPage(clientName string, domain string, scopes []string, csrfToken string, req string, errorMsg string, successMsg string, eligibleOrgs []OrgOption, selectedOrgID string) {
	@BaseLayout("Authorize application - anekdote", ConsentPageBody(clientName, domain, scopes, csrfToken, req, errorMsg, successMsg, eligibleOrgs, selectedOrgID))
}

templ ConsentPageBody(clientName string, domain string, scopes []string, csrfToken string, req string, errorMsg string, successMsg string, eligibleOrgs []OrgOption, selectedOrgID string) {
	<div class="w-full space-y-5 rounded-lg border border-zinc-800 bg-zinc-900 p-6 shadow">
		@ClientTrustBadge(clientName, domain)

		<div class="border-b border-zinc-800"></div>

		@AlertContainer(errorMsg, successMsg)

		if len(eligibleOrgs) > 1 {
			<div class="space-y-2">
				<p class="text-sm text-zinc-400">Choose the organization for this sign-in:</p>
				<div class="space-y-1.5">
					for _, org := range eligibleOrgs {
						<label class="flex cursor-pointer items-center gap-3 rounded-md border border-zinc-700 px-3 py-2.5 hover:border-zinc-500 has-[:checked]:border-brand has-[:checked]:bg-brand/5 transition-colors">
							<input type="radio" name="selected_org_id" value={ org.ID } class="accent-brand" required/>
							<div>
								<p class="text-sm font-medium text-zinc-200">{ org.Name }</p>
								<p class="text-xs text-zinc-500">{ org.Slug }</p>
							</div>
						</label>
					}
				</div>
			</div>
			<div class="border-b border-zinc-800"></div>
		}

		if len(scopes) > 0 {
			<div class="space-y-2">
				<p class="text-sm text-zinc-400">{ clientName } is asking for:</p>
				<ul class="space-y-2">
					for _, scope := range scopes {
						@ScopeItem(scopeIcon(scope), scopeDescription(scope))
					}
				</ul>
			</div>
			<div class="border-b border-zinc-800"></div>
		}

		<form method="POST" action="" class="flex flex-col gap-3">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			if req != "" {
				<input type="hidden" name="consent_challenge" value={ req }/>
			}
			if selectedOrgID != "" && len(eligibleOrgs) <= 1 {
				<input type="hidden" name="selected_org_id" value={ selectedOrgID }/>
			}
			<button
				type="submit"
				name="accept"
				value="true"
				class="inline-flex h-9 w-full items-center justify-center rounded-md bg-brand px-3 text-sm font-medium text-zinc-950 transition-all duration-150 hover:bg-brand-hover active:scale-[0.98]"
			>
				Authorize { clientName }
			</button>
			<button
				type="submit"
				name="reject"
				value="true"
				class="inline-flex h-9 w-full items-center justify-center rounded-md border border-zinc-800 bg-transparent px-3 text-sm font-medium text-zinc-50 transition-all duration-150 hover:bg-zinc-900 hover:border-zinc-700 active:scale-[0.98]"
			>
				Cancel
			</button>
		</form>

		<p class="text-center text-xs text-zinc-500">Org owners can revoke access from organization settings</p>
	</div>
}

templ OAuthAccessDeniedPage(clientName string, orgName string, returnURL string) {
	@BaseLayout("Access Denied - anekdote", OAuthAccessDeniedBody(clientName, orgName, returnURL))
}

templ OAuthAccessDeniedBody(clientName string, orgName string, returnURL string) {
	<div class="w-full space-y-5 rounded-lg border border-zinc-800 bg-zinc-900 p-6 shadow text-center">
		<div class="flex justify-center">
			<div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-500/10">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="15" y1="9" x2="9" y2="15"></line>
					<line x1="9" y1="9" x2="15" y2="15"></line>
				</svg>
			</div>
		</div>
		<div>
			<h1 class="text-lg font-semibold">Access denied</h1>
			if orgName != "" {
				<p class="mt-1.5 text-sm text-zinc-400">
					You are not a member of <span class="text-zinc-200">{ orgName }</span>.
					Contact an org owner to request access.
				</p>
			} else {
				<p class="mt-1.5 text-sm text-zinc-400">
					You don&#39;t have access to <span class="text-zinc-200">{ clientName }</span>.
					Contact the application owner to request access.
				</p>
			}
		</div>
		<div class="flex flex-col gap-2">
			if returnURL != "" {
				<a
					href={ templ.SafeURL(returnURL) }
					class="inline-flex h-9 w-full items-center justify-center rounded-md bg-brand px-3 text-sm font-medium text-zinc-950 transition-all duration-150 hover:bg-brand-hover active:scale-[0.98]"
				>Return to { clientName }</a>
			}
			<a
				href="/account"
				class="inline-flex h-9 w-full items-center justify-center rounded-md border border-zinc-800 bg-transparent px-3 text-sm font-medium text-zinc-50 transition-all duration-150 hover:bg-zinc-900 hover:border-zinc-700"
			>Back to your account</a>
		</div>
	</div>
}

// OAuthAccessDeniedNoGrant is shown when the client has no org grants for any org the user belongs to.
templ OAuthAccessDeniedNoGrant(clientName string, returnURL string) {
	@BaseLayout("Access Denied - anekdote", OAuthAccessDeniedNoGrantBody(clientName, returnURL))
}

templ OAuthAccessDeniedNoGrantBody(clientName string, returnURL string) {
	<div class="w-full space-y-5 rounded-lg border border-zinc-800 bg-zinc-900 p-6 shadow text-center">
		<div class="flex justify-center">
			<div class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-500/10">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="12" y1="8" x2="12" y2="12"></line>
					<line x1="12" y1="16" x2="12.01" y2="16"></line>
				</svg>
			</div>
		</div>
		<div>
			<h1 class="text-lg font-semibold">No access granted</h1>
			<p class="mt-1.5 text-sm text-zinc-400">
				None of your organizations have granted <span class="text-zinc-200">{ clientName }</span> access yet.
				Ask your org owner to add this application from organization settings.
			</p>
		</div>
		<div class="flex flex-col gap-2">
			if returnURL != "" {
				<a
					href={ templ.SafeURL(returnURL) }
					class="inline-flex h-9 w-full items-center justify-center rounded-md bg-brand px-3 text-sm font-medium text-zinc-950 transition-all duration-150 hover:bg-brand-hover active:scale-[0.98]"
				>Return to { clientName }</a>
			}
			<a
				href="/account"
				class="inline-flex h-9 w-full items-center justify-center rounded-md border border-zinc-800 bg-transparent px-3 text-sm font-medium text-zinc-50 transition-all duration-150 hover:bg-zinc-900 hover:border-zinc-700"
			>Back to your account</a>
		</div>
	</div>
}

func scopeDescription(scope string) string {
	switch scope {
	case "openid":
		return "Verify your identity"
	case "profile":
		return "Read your name and profile"
	case "email":
		return "Read your email address"
	case "offline_access":
		return "Stay signed in when you're not using the app"
	default:
		return scope
	}
}

func scopeIcon(scope string) string {
	switch scope {
	case "email":
		return "mail"
	case "profile":
		return "eye"
	case "offline_access":
		return "clock"
	default:
		return "check"
	}
}
