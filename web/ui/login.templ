package ui

templ LoginPage(csrfToken, req, email, errorMsg, successMsg string) {
	@BaseLayout("Login - anekdote", LoginPageBody(csrfToken, req, email, errorMsg, successMsg))
}

templ LoginPageBody(csrfToken, req, email, errorMsg, successMsg string) {
	<div class="w-full space-y-6 rounded-lg border border-zinc-800 bg-zinc-900 p-6 shadow">
		<div class="flex flex-col items-center gap-1.5 text-center">
			<h2 class="text-xl font-semibold tracking-tight">Welcome back.</h2>
			<p class="text-sm text-zinc-400">Sign in to your account</p>
		</div>

		@AlertContainer(errorMsg, successMsg)

		<form method="POST" action="/login" class="flex flex-col gap-5">
			<input type="hidden" name="csrf_token" value={ csrfToken } />
			if req != "" {
				<input type="hidden" name="req" value={ req } />
			}

			<div class="flex flex-col gap-4">
				@FormField("Email", "email", "", TextInput("email", "email", "email", "user@example.com", email, false))

				<div class="flex flex-col gap-1.5">
					<div class="flex items-center justify-between">
						<label for="password" class="text-sm font-medium text-zinc-50">Password</label>
						<a
							href="/forgot-password"
							class="text-xs text-zinc-400 hover:text-brand transition-colors duration-150"
						>
							Forgot your password?
						</a>
					</div>
					@PasswordInput("password", "password", false)
				</div>
			</div>

			@PrimaryButton("Sign in", "submit-login")
		</form>

		<p class="text-center text-xs text-zinc-400">
			New here?
			<a
				href="/register"
				class="ml-1 font-medium text-zinc-50 hover:text-brand transition-colors duration-150"
			>
				Create an account →
			</a>
		</p>
	</div>
}
