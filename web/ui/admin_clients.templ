package ui

import (
	"github.com/iabhishekrajput/anekdote-auth/internal/store/postgres"
)

templ AdminClientList(csrfToken string, clients []*postgres.AdminClientItem, total int, cursor, nextCursor string, errorMsg, successMsg string) {
	@AdminLayout("Clients - Admin", "/admin/clients", csrfToken, adminClientListBody(csrfToken, clients, total, cursor, nextCursor, errorMsg, successMsg))
}

templ adminClientListBody(csrfToken string, clients []*postgres.AdminClientItem, total int, cursor, nextCursor string, errorMsg, successMsg string) {
	<div class="space-y-4">
		<div>
			<h1 class="text-xl font-semibold tracking-tight">OAuth2 Clients</h1>
			<p class="text-sm text-zinc-400">{ intToStr(total) } clients across all orgs</p>
		</div>
		@AlertContainer(errorMsg, successMsg)
		<div class="rounded-lg border border-zinc-800 overflow-hidden">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-zinc-800 bg-zinc-900/60">
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Client ID</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Name</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Org</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Type</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Redirect URI</th>
						<th class="px-4 py-2.5 text-left font-medium text-zinc-400">Created</th>
						<th class="px-4 py-2.5"></th>
					</tr>
				</thead>
				<tbody>
					if len(clients) == 0 {
						<tr>
							<td colspan="7" class="px-4 py-8 text-center text-zinc-500">No clients registered.</td>
						</tr>
					}
					for _, c := range clients {
						<tr class="border-b border-zinc-800/60 last:border-0 hover:bg-zinc-900/40">
							<td class="px-4 py-3 font-mono text-xs text-zinc-400">{ c.ID[:8] }…</td>
							<td class="px-4 py-3 text-zinc-200">{ c.Name }</td>
							<td class="px-4 py-3 text-zinc-400">
								if c.OrgName != "" {
									<a href={ templ.SafeURL("/admin/orgs/" + c.OrgSlug) } class="hover:text-brand">{ c.OrgName }</a>
								} else {
									<span class="text-zinc-600">—</span>
								}
							</td>
							<td class="px-4 py-3">
								if c.Public {
									<span class="rounded bg-sky-500/10 px-1.5 py-0.5 text-xs text-sky-400">Public</span>
								} else {
									<span class="rounded bg-violet-500/10 px-1.5 py-0.5 text-xs text-violet-400">Confidential</span>
								}
							</td>
							<td class="px-4 py-3 font-mono text-xs text-zinc-400 max-w-[200px] truncate">{ c.Domain }</td>
							<td class="px-4 py-3 text-xs text-zinc-500">{ c.CreatedAt.Format("2006-01-02") }</td>
							<td class="px-4 py-3 text-right">
								<form
									method="POST"
									action={ templ.SafeURL("/admin/clients/" + c.ID + "/delete") }
									data-confirm="Permanently delete this OAuth2 client? This cannot be undone."
								>
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									<input type="hidden" name="confirm" value="yes"/>
									<button
										type="submit"
										class="text-xs text-red-400 hover:text-red-300 hover:underline"
									>Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@cursorPaginationControls("/admin/clients", cursor, nextCursor)
	</div>
}

templ AdminClientClaimsPage(csrfToken string, clientID, clientName string, existing []postgres.ClaimDefinition, errorMsg, successMsg string) {
	@AdminLayout(clientName+" — Custom Claims - Admin", "/admin/clients", csrfToken, adminClientClaimsBody(csrfToken, clientID, clientName, existing, errorMsg, successMsg))
}

templ adminClientClaimsBody(csrfToken string, clientID, clientName string, existing []postgres.ClaimDefinition, errorMsg, successMsg string) {
	<div class="space-y-4">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-xl font-semibold tracking-tight">Custom Claims</h1>
				<p class="text-sm text-zinc-400 font-mono">{ clientName }</p>
			</div>
			<a href="/admin/clients" class="text-sm text-zinc-400 hover:text-zinc-50 transition-colors">← Back to clients</a>
		</div>

		@AlertContainer(errorMsg, successMsg)

		<div class="rounded-lg border border-zinc-800">
			<div class="border-b border-zinc-800 px-4 py-3">
				<h2 class="text-sm font-semibold">Edit Claims</h2>
				<p class="text-xs text-zinc-500 font-mono mt-0.5">{ clientID }</p>
			</div>
			<div class="p-4 space-y-4">
				<form method="POST" action={ templ.SafeURL("/admin/clients/" + clientID + "/claims") } class="space-y-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="overflow-x-auto">
						<table class="w-full text-sm" id="claims-table">
							<thead>
								<tr class="border-b border-zinc-800">
									<th class="pb-2 text-left font-medium text-zinc-400 pr-3 w-[30%]">Key</th>
									<th class="pb-2 text-left font-medium text-zinc-400 pr-3 w-[12%]">Type</th>
									<th class="pb-2 text-left font-medium text-zinc-400 pr-3 w-[28%]">Value</th>
									<th class="pb-2 text-left font-medium text-zinc-400 pr-3 w-[22%]">Destination</th>
									<th class="pb-2 w-8"></th>
								</tr>
							</thead>
							<tbody id="claims-rows">
								if len(existing) == 0 {
									<tr id="empty-state-row">
										<td colspan="5" class="py-6 text-center text-sm text-zinc-500">No custom claims yet. Add your first claim below.</td>
									</tr>
								}
								for _, d := range existing {
									<tr class="border-b border-zinc-800/60 last:border-0">
										<td class="py-2 pr-3">
											<input type="text" name="key[]" value={ d.Key } class="h-8 w-full rounded border border-zinc-800 bg-transparent px-2 text-sm font-mono text-zinc-50 outline-none focus:border-brand focus:ring-1 focus:ring-brand/50"/>
										</td>
										<td class="py-2 pr-3">
											<select name="type[]" data-type-select class="h-8 w-full rounded border border-zinc-800 bg-zinc-950 px-2 text-sm text-zinc-50 outline-none focus:border-brand">
												<option value="string" selected?={ d.ValueType == "string" }>string</option>
												<option value="number" selected?={ d.ValueType == "number" }>number</option>
												<option value="boolean" selected?={ d.ValueType == "boolean" }>boolean</option>
											</select>
										</td>
										<td class="py-2 pr-3">
											if d.ValueType == "boolean" {
												<select name="value[]" class="h-8 w-full rounded border border-zinc-800 bg-zinc-950 px-2 text-sm text-zinc-50 outline-none focus:border-brand">
													<option value="true" selected?={ d.Value == "true" }>true</option>
													<option value="false" selected?={ d.Value == "false" }>false</option>
												</select>
											} else {
												<input type="text" name="value[]" value={ d.Value } class="h-8 w-full rounded border border-zinc-800 bg-transparent px-2 text-sm font-mono text-zinc-50 outline-none focus:border-brand focus:ring-1 focus:ring-brand/50"/>
											}
										</td>
										<td class="py-2 pr-3">
											<select name="destination[]" class="h-8 w-full rounded border border-zinc-800 bg-zinc-950 px-2 text-sm text-zinc-50 outline-none focus:border-brand">
												<option value="token" selected?={ d.Destinations == "token" || d.Destinations == "" }>Both tokens</option>
												<option value="access_token" selected?={ d.Destinations == "access_token" }>Access token only</option>
												<option value="id_token" selected?={ d.Destinations == "id_token" }>ID token only</option>
												<option value="userinfo" selected?={ d.Destinations == "userinfo" }>UserInfo only</option>
												<option value="access_token,userinfo" selected?={ d.Destinations == "access_token,userinfo" }>Access token + UserInfo</option>
												<option value="id_token,userinfo" selected?={ d.Destinations == "id_token,userinfo" }>ID token + UserInfo</option>
												<option value="token,userinfo" selected?={ d.Destinations == "token,userinfo" }>Both tokens + UserInfo</option>
												<option value="access_token,id_token,userinfo" selected?={ d.Destinations == "access_token,id_token,userinfo" }>All</option>
											</select>
										</td>
										<td class="py-2">
											<button type="button" data-dismiss-parent class="h-8 w-8 inline-flex items-center justify-center rounded border border-zinc-800 text-zinc-500 hover:text-red-400 hover:border-red-800 transition-colors">×</button>
										</td>
									</tr>
								}
								<tr data-claims-template aria-hidden="true" class="hidden border-b border-zinc-800/60">
									<td class="py-2 pr-3">
										<input type="text" name="key[]" value="" placeholder="https://example.com/tier" class="h-8 w-full rounded border border-zinc-800 bg-transparent px-2 text-sm font-mono text-zinc-50 outline-none focus:border-brand focus:ring-1 focus:ring-brand/50"/>
									</td>
									<td class="py-2 pr-3">
										<select name="type[]" data-type-select class="h-8 w-full rounded border border-zinc-800 bg-zinc-950 px-2 text-sm text-zinc-50 outline-none focus:border-brand">
											<option value="string" selected>string</option>
											<option value="number">number</option>
											<option value="boolean">boolean</option>
										</select>
									</td>
									<td class="py-2 pr-3">
										<input type="text" name="value[]" value="" class="h-8 w-full rounded border border-zinc-800 bg-transparent px-2 text-sm font-mono text-zinc-50 outline-none focus:border-brand focus:ring-1 focus:ring-brand/50"/>
									</td>
									<td class="py-2 pr-3">
										<select name="destination[]" class="h-8 w-full rounded border border-zinc-800 bg-zinc-950 px-2 text-sm text-zinc-50 outline-none focus:border-brand">
											<option value="token" selected>Both tokens</option>
											<option value="access_token">Access token only</option>
											<option value="id_token">ID token only</option>
											<option value="userinfo">UserInfo only</option>
											<option value="access_token,userinfo">Access token + UserInfo</option>
											<option value="id_token,userinfo">ID token + UserInfo</option>
											<option value="token,userinfo">Both tokens + UserInfo</option>
											<option value="access_token,id_token,userinfo">All</option>
										</select>
									</td>
									<td class="py-2">
										<button type="button" data-dismiss-parent class="h-8 w-8 inline-flex items-center justify-center rounded border border-zinc-800 text-zinc-500 hover:text-red-400 hover:border-red-800 transition-colors">×</button>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
					<div class="flex items-center justify-between gap-4">
						<p class="text-xs text-amber-400/80 border border-amber-400/20 rounded px-3 py-2 bg-amber-400/5">
							Changes apply to newly issued tokens only. Existing tokens retain their claims until expiry.
						</p>
						<div class="flex-none">
							<button
								type="submit"
								class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-brand px-6 text-sm font-medium text-zinc-950 transition-all duration-150 hover:bg-brand-hover active:scale-[0.98]"
							>Save claims</button>
						</div>
					</div>
					<div id="add-claim-area">
						<button type="button" data-add-claim-row class="text-sm text-zinc-400 hover:text-zinc-50 transition-colors duration-150">+ Add claim</button>
						<p id="max-claims-notice" class="hidden text-xs text-zinc-500">Maximum 20 claims reached.</p>
					</div>
				</form>
			</div>
		</div>
	</div>
}
