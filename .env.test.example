# Copy to .env.test and fill in values for local E2E test runs.
# These are loaded by playwright.config.ts via the webServer env block.
# Never commit .env.test — it is gitignored.

PORT=8080
APP_URL=http://localhost:8080
APP_ENV=test

DB_DSN=postgres://authuser:authpassword@localhost:5432/authdb?sslmode=disable
REDIS_URL=redis://localhost:6379/0

RSA_PRIVATE_KEY_PATH=certs/private.pem
RSA_PUBLIC_KEY_PATH=certs/public.pem

# Mailpit local SMTP — no TLS needed
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=test
SMTP_PASSWORD=test
SMTP_FROM=noreply@anekdoteauth.local
SMTP_INSECURE_SKIP_VERIFY=true

# Mailpit API (used by tests/fixtures/mail.ts)
MAILPIT_URL=http://localhost:8025

# Dev-only encryption key — insecure, do NOT use in production
# Generate a real key with: openssl rand -hex 32
REDIS_ENCRYPTION_KEY=

# E2E base URL for Playwright
E2E_BASE_URL=http://localhost:8080
